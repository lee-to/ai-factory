# --- Justfile for JVM Projects (Maven) ---

set shell := ["bash", "-c"]

project := `basename $(pwd)`
version := `git describe --tags --always --dirty 2>/dev/null || echo "dev"`
commit  := `git rev-parse --short HEAD 2>/dev/null || echo "unknown"`

entrypoint := `if [ -f ./mvnw ]; then echo "./mvnw"; else echo "mvn"; fi`

docker-registry := "ghcr.io"
docker-image    := docker-registry + "/" + project

# --- Default ---
default:
    @just --list

# --- Development ---
clean:
    {{entrypoint}} clean

build:
    {{entrypoint}} verify

assemble:
    {{entrypoint}} package

dev:
    {{entrypoint}} spring-boot:run

# --- Testing ---
test:
    {{entrypoint}} test

check:
    {{entrypoint}} verify

# --- Quality ---
lint:
    {{entrypoint}} checkstyle:check

fmt:
    {{entrypoint}} spotless:apply

# --- Docker ---
docker-build:
    docker build \
        --build-arg VERSION={{version}} \
        --build-arg COMMIT={{commit}} \
        -t {{docker-image}}:{{version}} \
        -t {{docker-image}}:latest \
        .

docker-push:
    docker push {{docker-image}}:{{version}}
    docker push {{docker-image}}:latest

# --- Database ---
db-migrate:
    {{entrypoint}} liquibase:update

# --- CI ---
ci: clean check assemble
